# Copia este archivo a .env.local y completa con los valores de tu proyecto
# Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx

# Solo la necesita scripts/generate-sessions.mjs. NUNCA la pongas con el
# prefijo NEXT_PUBLIC_ ni la subas a GitHub: da acceso total a la base de datos.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
